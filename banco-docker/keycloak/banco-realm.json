{
  "id": "banco-digital",
  "realm": "banco-digital",
  "displayName": "Sistema Bancario Digital - Grupo #4",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrador de la plataforma bancaria"
      },
      {
        "name": "ASESOR",
        "description": "Asesor bancario"
      },
      {
        "name": "CLIENTE",
        "description": "Cliente bancario final"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banco-frontend",
      "name": "Frontend NexoBank",
      "description": "Cliente OIDC público para la aplicación web React",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://banco-dokr.onrender.com/*",
        "https://banco-dokr.onrender.com/",
        "http://localhost/*",
        "http://localhost:80/*",
        "http://localhost:5173/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://banco-dokr.onrender.com/*##http://localhost/*##http://127.0.0.1/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "Banco API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "banco-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
