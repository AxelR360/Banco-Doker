# ============================================================
# Banco Digital (NexoBank) — Plantilla de Variables de Entorno
# ============================================================

# Conexión directa a MySQL en la nube (Aiven)
DB_HOST=mysql-3f9eaa80-sistema-basededatos.i.aivencloud.com
DB_PORT=24201
DB_NAME=banco_digital
DB_USER=avnadmin
DB_PASS=tu_password_aiven
DB_SSL=1

# Clave JWT para tokens de sesión
BANCO_JWT_SECRET=esmeraldas_nexo_bank_secret_key_2026_jwt_token
BANCO_DEMO_LOGIN=1

# Keycloak SSO — Reino Banco y Cliente banco-frontend
KEYCLOAK_REALM_URL=http://host.docker.internal:8080/realms/Banco
KEYCLOAK_ALLOWED_ISSUERS=http://localhost:8080/realms/Banco,http://127.0.0.1:8080/realms/Banco
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=Banco
VITE_KEYCLOAK_CLIENT_ID=banco-frontend
